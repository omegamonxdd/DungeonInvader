# Copia este archivo a .env y rellena los valores de tu proyecto de Supabase.
# Sin estas variables el juego funciona en modo local (localStorage).

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-ANON-KEY
VITE_APP_VERSION=0.1.0

# Solo desarrollo local (copiar a .env.local, ignorado por git): fuerza
# recursos para pruebas en TODA partida. No definir en producción.
# VITE_DEV_RESOURCES=999999
